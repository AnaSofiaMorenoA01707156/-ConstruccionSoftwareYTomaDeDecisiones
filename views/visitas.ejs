<%- include('includes/header') %>
    <section>
        <hr>
        <h3 class="subtitulo">Visitantes del sitio:</h3>
        <div class="columns-container">
            <% for (let visita of visitantes) { %>
                <div class="column">
                    <p class="texto"><%= visita.nombre %>, <%= visita.color %></p>
                    <p id="linkImagen" class="link">Ver imagen</p>
                    <br><br>
                </div>
            <% } %>
        </div>
        <br><br>
        <div class="campoBoton">
            <a href="/home">
                <button class="boton">Regresar a Home</button>
            </a>
        </div>
        <hr>
    </section>
    <script>
        const linkImg = document.getElementById("linkImagen");
        linkImg.onclick = () => {
            fetch(`/forms/visitas/fotoVisita`,{
            method: 'GET',
            }).then((result) => {
                return result.json(); 
            }).then((data) => {
             console.log(data); 
            }).catch((error) => {
                console.log(error);
            });
        }
    </script>
<%- include('includes/footer') %>