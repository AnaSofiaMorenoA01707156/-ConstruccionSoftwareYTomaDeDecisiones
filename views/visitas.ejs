<%- include('includes/header') %>
    <section>
        <hr>
        <h3 class="subtitulo">Visitantes del sitio:</h3>
        <div class="columns-container">
            <% for (let visita of visitantes) { %>
                <div class="column">
                    <p class="texto"><%= visita.nombre %>, <%= visita.color %></p>
                    <p class="link" data-username="<%= visita.username %>">Ver imagen</p>
                    <br><br>
                </div>
            <% } %>
        </div>
        <br><br>
        <div class="campoBoton">
            <a href="/home">
                <button class="boton">Regresar a Home</button>
            </a>
        </div>
        <hr>
    </section>
    <script>
        const linksImagenes = document.querySelectorAll(".link");
        linksImagenes.forEach(link => {
            link.onclick = () => {
                const username = link.dataset.username;
                fetch(`/forms/visitas/fotoVisita/${username}`, {
                    method: 'GET',
                })
                .then(result => result.json())
                .then(data => {
                    console.log(data);
                })
                .catch(error => {
                    console.log(error);
                });
            };
    });

    </script>
<%- include('includes/footer') %>