<%- include('includes/header') %>
    <section>
        <hr>
        <h3 class="subtitulo">Visitantes del sitio:</h3>
        <div class="columns-container">
            <% for (let visita of visitantes) { %>
                <div class="column">
                    <p class="texto">
                        Username: <%= visita.username %> Nombre: <%= visita.nombre %><br> Color favorito: <%=
                                    visita.color %>, Puntos:
                                    <%= visita.puntos %>
                    </p>
                    <p class="link" data-username="<%= visita.username %>">Ver imagen</p>
                    <br><br>
                </div>
                <% } %>
        </div>
        <br><br>
        <div class="campoBoton">
            <a href="/home">
                <button class="boton">Regresar a Home</button>
            </a>
        </div>
        <hr>
    </section>
    <script>
        const linksImagenes = document.querySelectorAll(".link");
        linksImagenes.forEach(link => {
            link.onclick = () => {
                const username = link.dataset.username;
                fetch(`/forms/visitas/fotoVisita/${username}`, {
                    method: 'GET',
                })
                    .then(result => result.json())
                    .then(data => {
                        if (data.imagen) {
                            link.outerHTML = `<img src="/${data.imagen}" alt="Imagen de visita">`;
                        } else {
                            link.outerHTML = `<p>${data.error || "La visita no subió ninguna imagen."}</p>`;
                        }
                    })
                    .catch(error => {
                        console.log(error);
                    });
            };
        });

    </script>
    <%- include('includes/footer') %>