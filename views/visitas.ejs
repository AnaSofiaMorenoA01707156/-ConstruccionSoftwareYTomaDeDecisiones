<%- include('includes/header') %>
    <section>
        <hr>
        <h3 class="subtitulo">Visitantes del sitio:</h3>
        <div class="columns-container">
            <% for (let visita of visitantes) { %>
                <div class="column">
                    <p class="texto"><%= visita.nombre %>, <%= visita.color %></p>
                    <figure >
                        <img src="<%= juego.imagen %>" />
                    </figure>
                    <br><br>
                </div>
            <% } %>
        </div>
        <br><br>
        <div class="campoBoton">
            <a href="/home">
                <button class="boton">Regresar a Home</button>
            </a>
        </div>
        <hr>
    </section>
<%- include('includes/footer') %>