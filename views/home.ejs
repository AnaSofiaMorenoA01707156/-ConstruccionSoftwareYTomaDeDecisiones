<%- include('includes/header') %>
<body>
    <h1 class="titulo">Home page</h1>
    <h2 class="subtitulo">
        <% if (typeof(nombre) != "undefined") { %>
            ¡Bienvenido, <%= nombre %>!
        <% } else { %>
            ¡Bienvenido usuario!
        <% } %>
    </h2>
    <h3 class="marcado">
        <% if (typeof(color) != "undefined") { %>
            En efecto, el <%= color %> es un gran color.
        <% } else { %>
            Aún no te has registrado, o no has registrado un color favorito.
        <% } %>
    </h3>
    <iframe width="100%" height="300" scrolling="no" frameborder="no" allow="autoplay" 
        src="https://w.soundcloud.com/player/?url=https%3A//api.soundcloud.com/tracks/soundcloud%253Atracks%253A1924231610&color=%23f47c44&auto_play=true&hide_related=false&show_comments=true&show_user=true&show_reposts=false&show_teaser=true&visual=true">
    </iframe>
<div style="font-size: 10px; color: #cccccc;line-break: anywhere;word-break: normal;overflow: hidden;white-space: nowrap;text-overflow: ellipsis; font-family: Interstate,Lucida Grande,Lucida Sans Unicode,Lucida Sans,Garuda,Verdana,Tahoma,sans-serif;font-weight: 100;">
    <a href="https://soundcloud.com/greghumphreysmusic" title="Greg Humphreys Music" target="_blank" style="color: #cccccc; text-decoration: none;">Greg Humphreys Music</a>
    <a href="https://soundcloud.com/greghumphreysmusic/fall-into-the-sea" title="Fall Into The Sea" target="_blank" style="color: #cccccc; text-decoration: none;">Fall Into The Sea</a>
</div>
     <hr><br>
    <h3 class="marcado">Aplicación web de Ana Sofía Moreno A01707156, para mostrar trabajo acumulativo en laboratorios y aprendizaje de la materia Construcción de Software y Toma de Decisiones.</h3>
    <hr><br>
    <div class="campoBoton">
        <a href="/laboratorios">
            <button class="boton">Preguntas de labs</button>
        </a>
        <a href="/forms/visitas">
                <button class="boton">Visitantes del sitio</button>
        </a>
        <% if (typeof(username) != "undefined") { %>
            <a href="/forms/edicion">
                <button class="boton">Editar color favorito</button>
            </a>
            <a href="/forms/cerrarSesion">
                <button class="boton">Cerrar sesión</button>
            </a>
        <% } else { %>
            <a href="/forms/registro">
                <button class="boton">Registrarme</button>
            </a>
            <a href="/forms/inicioSesion">
                <button class="boton">Iniciar sesión</button>
            </a>
        <% } %>
    </div>
    <hr>
</body>
<script src="https://w.soundcloud.com/player/api.js"></script>
