<%- include('includes/header') %>
        <section>
            <hr>
            <h2 class="subtitulo">Registro de visita</h2>
            <h3 class="marcado">Regístrate para poder ver los visitantes del sitio y para poder registrar o modificar tu color favorito.</h3>
            <p class="texto">* = Campos obligatorios. El resto es información opcional para tu perfil.</p>
            <section id="formSection">
                <div id="registerContainer">
                    <form id="forma" action="/forms/registro" method="POST" enctype="multipart/form-data">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="campo">
                            <label for="username">Username:*<br></label>
                            <input type="text" id="username" name="username" required/>
                        </div>
                        <div class="campo">
                            <label for="nombre">Nombre:*<br></label>
                            <input type="text" id="nombre" name="nombre" placeholder="e.g. Sancho" required/>
                        </div>
                        <div class="campo">
                            <label for="color">Color favorito:<br></label>
                            <input type="text" id="color" name="color" placeholder="e.g. amarillo"/>
                        </div>
                        <div id="campoP" class="campo">
                            <label for="password">Password (contraseña):*<br></label>
                            <input type="password" id="password" name="password" required/>
                        </div>
                        <div id="campoV" class="campo">
                            <label for="verif">Verificar password:*<br></label>
                            <input type="password" id="verif" name="verif" required/>
                        </div>
                        <div class="campo">
                            <label for="imagenUsuario">Imagen que te represente:</label>
                            <input type="file" id="imagenUsuario" name="imagenUsuario">
                        </div>
                        <div id="toAccept" class="campoBoton">
                            <input type="button" id="botonReinicio" class="boton" value="Reiniciar"/>
                            <input type="button" id="botonValidar" class="boton" value="Validar"/>
                        </div>
                    </form>
                </div><br>
            </section>
            <div class="campoBoton">
                <a href="/home">
                    <button class="boton">Regresar a Home</button>
                </a>
            </div>
            <br><hr>
        </section>
        <script> //Script creado para el lab6 ([Opción A], validación de passwords). Retomado para usarlo en registro de mi página.
            const enviado = document.getElementById("botonValidar");
            const forma = document.getElementById("forma");
            const inputPswd = document.getElementById("password");   const inputUser = document.getElementById("username");
            const inputVerif = document.getElementById("verif");    const inputNombre = document.getElementById("nombre");
            const reset = document.getElementById("botonReinicio");
            const limpiar = () => {
                document.querySelectorAll(".inputWarning").forEach(el => el.remove());
                forma.reset();
            }
            const validar = () => {
                document.querySelectorAll(".inputWarning").forEach(el => el.remove());
                let pswd = forma["password"].value;
                let verif = forma["verif"].value;
                let user = forma["username"].value;
                let nombre = forma["nombre"].value;
                if (user == "") {
                    inputUser.insertAdjacentHTML("afterend", `<p class="inputWarning">Campo requerido.</p>`);
                }if (nombre == "") {
                    inputNombre.insertAdjacentHTML("afterend", `<p class="inputWarning">Campo requerido.</p>`);
                }if (pswd == "") {
                    inputPswd.insertAdjacentHTML("afterend", `<p class="inputWarning">Campo requerido.</p>`);
                }if (verif == "") {
                    inputVerif.insertAdjacentHTML("afterend", `<p class="inputWarning">Campo requerido.</p>`);
                }else if (pswd != "" && verif != "")
                    if (pswd == verif){
                        document.getElementById('toAccept').insertAdjacentHTML("afterend",
                        `<h2 id="aceptado" class="marcado">Los campos son válidos y las contraseñas coinciden. ¿Proceder a registrar este perfil de usuario?</h2>
                        <div class="campoBoton">
                            <input type="submit" value="Registrar" id="botonRegistrar"/>
                        </div>`);
                    }else {
                        inputVerif.insertAdjacentHTML("afterend", `<p class="inputWarning">El password y la verificación del mismo no coinciden. <br>Intenta de nuevo.</p>`);
                        forma.reset();
                    }
            }
            enviado.onclick = validar;
            reset.onclick = limpiar;
        </script>
<%- include('includes/footer') %>